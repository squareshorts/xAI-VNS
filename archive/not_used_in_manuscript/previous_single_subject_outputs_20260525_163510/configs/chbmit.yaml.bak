# CHB-MIT Specific Configuration
data_dir: "data/external/chbmit"  # Relative to project root, or absolute path

# List of subjects to process (01 to 24). 
# Defaulting to 01-05 for faster execution.
subjects:
  - "01"
  - "02"
  - "03"
  - "04"
  - "05"

# Channel selection (e.g. 10-20 system subset if needed)
# If empty, all available channels are used
channels: []
