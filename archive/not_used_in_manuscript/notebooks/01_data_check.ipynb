   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Explainable VNS - 01 Data Check\n",
    "This notebook demonstrates loading CHB-MIT (or synthetic) EEG data and visualizing the raw signal."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "sys.path.append(str(Path.cwd().parent))\n",
    "from src.data.load_chbmit import load_or_generate_data\n",
    "from src.utils.paths import DATA_DIR\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data_dict = load_or_generate_data('chb01', DATA_DIR, use_synthetic=True)\n",
    "data = data_dict['data']\n",
    "sfreq = data_dict['sfreq']\n",
    "seizures = data_dict['seizures']\n",
    "ch_names = data_dict['ch_names']\n",
    "print(f\"Loaded {data.shape[1]} samples across {data.shape[0]} channels at {sfreq} Hz.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "time = np.arange(data.shape[1]) / sfreq\n",
    "plt.figure(figsize=(15, 5))\n",
    "# Plot first channel\n",
    "plt.plot(time, data[0, :], lw=0.5)\n",
    "for sz_start, sz_end in seizures:\n",
    "    plt.axvspan(sz_start, sz_end, color='red', alpha=0.3, label='Seizure')\n",
    "plt.xlabel('Time (s)')\n",
    "plt.ylabel('Amplitude')\n",
    "plt.title(f\"Channel {ch_names[0]} with Seizure Annotations\")\n",
    "plt.show()"
   ]
  }
 ],
